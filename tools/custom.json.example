{
  "_说明": [
    "把这个文件改名为 custom.json，放到手机的",
    "Android/data/com.wxq.assist/files/data/custom.json",
    "App 启动时会把这里的内容追加到内置数据上，同名的以内置为准。",
    "游戏周更，内置数据必然落后；在面板里看到「❓认出但数据库里没有」时，",
    "把那个名字按下面格式补进来，下次重启助手就能认了。不用重新编译 APK。"
  ],

  "camps": [
    {
      "n": "建木",
      "total": 0,
      "tiers": [3, 5],
      "members": ["把你见到的建木英雄名字填这里"]
    }
  ],

  "heroes": [
    {
      "id": -1,
      "n": "英雄名字",
      "q": 3,
      "c": "建木",
      "r": "前排",
      "kw": ["词条1", "词条2"]
    }
  ],

  "_字段含义": {
    "id": "随便填个负数即可，只用于内部区分",
    "n": "英雄名，必须和游戏里显示的完全一致，OCR 靠它匹配",
    "q": "阶数（费用），1-5",
    "c": "阵营名；新阵营记得同时在上面 camps 里加一条",
    "r": "定位：前排 / 输出 / 辅助",
    "kw": "词条数组，天赋打分会用它算联动，不确定就留空 []"
  }
}
